---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<section {...storyblokEditable(blok)} class="py-24 bg-white relative overflow-hidden border-t border-slate-100">
    <!-- Dekoracyjne elementy w tle -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-[#fef5f3] rounded-full mix-blend-multiply filter blur-3xl opacity-50 translate-x-1/3 -translate-y-1/2"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-[#FCFAF5] rounded-full mix-blend-multiply filter blur-2xl opacity-70 -translate-x-1/2 translate-y-1/2"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <!-- Dodajemy md:flex-row aby na tabletach ułożyło się to obok siebie, a na telefonach jedno pod drugim -->
        <div class="bg-white rounded-[2.5rem] shadow-xl border border-slate-100 overflow-hidden flex flex-col md:flex-row">
            
            <!-- Lewa strona: Zdjęcie PIONOWE (z efektem przybliżania) -->
            <!-- Używamy md:w-1/3 dla zdjęcia i md:w-2/3 dla tekstu. Dodano shrink-0 aby flexbox nie kurczył zdjęcia -->
            <div class="md:w-1/3 relative overflow-hidden aspect-[3/4] md:aspect-auto md:min-h-[600px] shrink-0">
                <img 
                    src={blok.zdjecie?.filename || "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"} 
                    alt={blok.imie_nazwisko || "Anna Górny-Bogulska"} 
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                >
                <!-- Delikatna nakładka gradientowa -->
                <div class="absolute inset-0 bg-gradient-to-t from-[#0f172a]/40 via-transparent to-transparent"></div>
            </div>

            <!-- Prawa strona: Treść / Cytat -->
            <!-- Tutaj wędruje pozostałe 2/3 szerokości -->
            <div class="md:w-2/3 p-8 md:p-12 lg:p-16 flex flex-col justify-center bg-[#FCFAF5]">
                
                <!-- Kicker / Nagłówek -->
                <div class="flex items-center gap-3 mb-8">
                    <span class="w-12 h-1 bg-[#F38160] rounded-full"></span>
                    <span class="text-[#F38160] font-bold uppercase tracking-wider text-sm">
                        {blok.rola || "Słowo od założycielki"}
                    </span>
                </div>

                <!-- Główny cytat -->
                <div class="relative">
                    <!-- Ikona cudzysłowu w tle -->
                    <i class="fa-solid fa-quote-left absolute -top-6 -left-4 md:-top-8 md:-left-6 text-5xl md:text-6xl text-slate-200 opacity-60 pointer-events-none"></i>
                    
                    <h3 class="text-2xl md:text-3xl lg:text-4xl font-extrabold text-[#0f172a] leading-tight mb-8 relative z-10 italic">
                        "{blok.cytat || "Pragnę świata, który akceptuje różnorodność, przyjmuje inność i jest gotowy do podejmowania dialogu."}"
                    </h3>
                </div>

                <!-- Rozwinięcie (Opcjonalny tekst dodatkowy) -->
                <p class="text-slate-600 text-base md:text-lg leading-relaxed mb-10 font-medium">
                    {blok.opis || "Zasoby są nieograniczone - wystarczy tylko je zauważyć i po nie sięgnąć. Dzieci i młodzież uczą się angielskiego dla swoich celów. Ucząc się u nas, przebywają w świecie przepełnionym empatią, w którym są widziane z tym, co wnoszą."}
                </p>

                <!-- Podpis -->
                <div class="flex items-center justify-between border-t border-slate-200 pt-8 mt-auto">
                    <div>
                        <p class="font-black text-xl text-[#0f172a] mb-1">{blok.imie_nazwisko || "Anna Górny-Bogulska"}</p>
                        <p class="text-sm font-bold text-slate-500 uppercase tracking-widest">{blok.podpis_rola || "Liderka Zmiany"}</p>
                    </div>
                    <!-- Opcjonalny przycisk lub ikona podpisu -->
                    <div class="w-12 h-12 rounded-full bg-[#fdeae5] text-[#F38160] flex items-center justify-center shadow-sm shrink-0">
                        <i class="fa-solid fa-heart"></i>
                    </div>
                </div>

            </div>

        </div>

    </div>
</section>