---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok } = Astro.props;
---

<section {...storyblokEditable(blok)} id="obiekcje" class="py-24 bg-white border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6 border-b border-slate-100 pb-8">
            <div class="max-w-2xl">
                <h2 class="text-[#F38160] font-bold uppercase tracking-wider text-sm mb-3">Mówimy jak jest</h2>
                <h3 class="text-4xl md:text-5xl font-extrabold text-[#0f172a] leading-tight">
                    {blok.title || "Rozwiewamy Wątpliwości"}
                </h3>
            </div>
            <p class="text-slate-500 font-medium max-w-sm md:text-right">
                Wybór szkoły to duża decyzja. Odpowiadamy na najczęstsze obiekcje szczerze i otwarcie.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            {
                // Tutaj mówimy: "Przeleć przez wszystkie bloki 'obiekcja_karta', 
                // które dodano w panelu, i narysuj je jeden po drugim."
                blok.karty?.map((karta) => {
                    return <StoryblokComponent blok={karta} />
                })
            }
            
            {/* Ten fragment wyświetli się TYLKO gdy w panelu nie dodasz jeszcze żadnych kart, jako wsparcie wizualne */}
            {(!blok.karty || blok.karty.length === 0) && (
                <div class="col-span-3 text-center p-8 border-2 border-dashed border-slate-300 rounded-2xl text-slate-500">
                    Brak obiekcji. Dodaj karty w panelu Storyblok do pola "karty".
                </div>
            )}
        </div>
    </div>
</section>