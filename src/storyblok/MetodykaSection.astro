---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<section {...storyblokEditable(blok)} id="metodyka" class="py-24 bg-white relative overflow-hidden">
    <!-- Dekoracyjne tło dla miękkości -->
    <div class="absolute top-1/2 left-0 w-96 h-96 bg-[#fdeae5] rounded-full mix-blend-multiply filter blur-3xl -translate-y-1/2 opacity-50"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-[#F38160] font-bold uppercase tracking-wider text-sm mb-3">
                {blok.subtitle || "Nasza Metodyka"}
            </h2>
            <h3 class="text-4xl md:text-5xl font-extrabold text-[#0f172a] leading-tight mb-6">
                {blok.title || "Więcej niż szkoła językowa"}
            </h3>
            <p class="text-xl text-slate-600 font-medium">
                {blok.description || "Nie uczymy z nudnych podręczników. Nasz ekosystem opiera się na dwóch filarach, które gwarantują niesamowite postępy bez łez i presji."}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            
            <!-- Karta 1: Fundamenty (NVC) -->
            <div class="bg-[#FCFAF5] rounded-[2rem] p-8 lg:p-10 shadow-sm border border-[#fef5f3] flex flex-col h-full group hover:-translate-y-1 transition-transform duration-300">
                <div class="w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-[#F38160] text-3xl mb-8 shadow-sm group-hover:scale-110 transition-transform">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                </div>
                <h4 class="text-2xl font-bold text-[#0f172a] mb-4">Nasze Fundamenty (NVC)</h4>
                <p class="text-slate-600 mb-8 flex-grow leading-relaxed font-medium">
                    To gleba, na której wzrastają nasi uczniowie. Opieramy się na <strong>Porozumieniu bez Przemocy (NVC)</strong>, minimediacjach <strong>SNO</strong> oraz pełnej akceptacji błędu. Uczeń czuje się u nas bezpiecznie, co uwalnia jego potencjał językowy.
                </p>
                <a href="fundamenty" class="inline-flex items-center justify-between px-6 py-4 bg-white text-[#0f172a] font-bold rounded-xl hover:text-[#F38160] transition-colors duration-300 w-full group/btn shadow-sm">
                    <span>Odkryj fundamenty</span>
                    <svg class="w-5 h-5 transform group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>

            <!-- Karta 2: Energie (Ruch i Emocje) -->
            <div class="bg-[#0f172a] text-white rounded-[2rem] p-8 lg:p-10 shadow-lg relative overflow-hidden flex flex-col h-full group hover:-translate-y-1 transition-transform duration-300">
                <!-- Ciemny Blob -->
                <div class="absolute -right-10 -top-10 w-48 h-48 bg-[#F38160] rounded-full mix-blend-multiply filter blur-3xl opacity-30"></div>
                
                <div class="w-16 h-16 bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl flex items-center justify-center text-[#F38160] text-3xl mb-8 group-hover:scale-110 transition-transform relative z-10">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <h4 class="text-2xl font-bold mb-4 relative z-10">Nasze 4 Energie</h4>
                <p class="text-slate-300 mb-8 flex-grow leading-relaxed font-medium relative z-10">
                    To napęd naszych zajęć. Łączymy naukę z emocjami (<strong>Teaching in Empathy</strong>), ruchem (<strong>Dynamic English</strong>) oraz relacjami rówieśniczymi. Zapomnij o cichym siedzeniu w szkolnej ławce.
                </p>
                <a href="energie" class="relative z-10 inline-flex items-center justify-between px-6 py-4 bg-white/10 border border-white/20 text-white font-bold rounded-xl hover:bg-white hover:text-[#0f172a] transition-colors duration-300 w-full group/btn">
                    <span>Zgłęb nasze energie</span>
                    <svg class="w-5 h-5 text-[#F38160] transform group-hover/btn:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>

        </div>
    </div>
</section>