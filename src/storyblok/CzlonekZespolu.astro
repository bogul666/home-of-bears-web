---
import { storyblokEditable } from '@storyblok/astro';
const { blok } = Astro.props;
---

<div {...storyblokEditable(blok)} class="group flex flex-col h-full bg-white rounded-[2rem] overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
    
    <div class="aspect-square w-full overflow-hidden relative bg-slate-100">
        <img 
            src={blok.zdjecie?.filename || "https://images.unsplash.com/photo-1544717302-de2939b7ef71?auto=format&fit=crop&w=800&q=80"} 
            alt={blok.imie || "Członek zespołu"} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            onerror="this.src='https://placehold.co/800x800/f8fafc/0f172a?text=Brak+Zdjęcia'"
        >
        <!-- Elegancki overlay na hover -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0f172a]/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
    </div>
    
    <div class="p-6 md:p-8 flex flex-col flex-grow bg-white relative">
        
        <!-- Pływająca litera (inicjał) nad zdjęciem - nowoczesny sznyt -->
        <div class="absolute -top-6 right-6 w-12 h-12 bg-[#F38160] text-white rounded-full flex items-center justify-center font-bold text-xl shadow-lg border-4 border-white transform group-hover:rotate-12 transition-transform">
             {blok.imie ? blok.imie.charAt(0).toUpperCase() : "🐻"}
        </div>
        
        <h4 class="text-xl font-bold text-[#0f172a] mb-1">{blok.imie || "Imię i Nazwisko"}</h4>
        <p class="text-[#F38160] text-sm font-bold uppercase tracking-wider mb-4">{blok.rola || "Mentor / Lektor"}</p>
        
      <!--  <p class="text-slate-600 text-sm leading-relaxed flex-grow font-medium">
            {blok.opis || "Złapany krótki opis pasji lektora, jego ulubionych zajęć lub dlaczego praca z dziećmi sprawia mu tak ogromną radość."}
        </p> -->
    </div>
</div>