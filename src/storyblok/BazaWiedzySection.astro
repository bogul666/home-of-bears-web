---
import { storyblokEditable } from '@storyblok/astro';
import { useStoryblokApi } from '@storyblok/astro';

const { blok } = Astro.props;
const storyblokApi = useStoryblokApi();

let articles = [];
try {
  const { data } = await storyblokApi.get('cdn/stories', {
    version: import.meta.env.DEV ? "draft" : "published",
    content_type: 'artykul', // Szukamy po typie artykułu, a nie po folderze!
    is_startpage: 0,
    per_page: 3, 
    sort_by: 'first_published_at:desc',
  });
  articles = data.stories;
} catch (error) {
  console.error("Błąd pobierania:", error);
}
---

<section {...storyblokEditable(blok)} class="py-24 bg-[#F8FAFC]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex justify-between items-end mb-12 border-b border-slate-200 pb-6">
            <div>
                <h2 class="text-[#F38160] font-bold uppercase text-sm mb-2">{blok.kicker}</h2>
                <h3 class="text-3xl md:text-4xl font-extrabold text-[#0f172a]">{blok.title}</h3>
                <p class="text-slate-500 mt-3">{blok.description}</p>
            </div>
            <a href="/baza-wiedzy" class="text-[#0f172a] font-bold hover:text-[#F38160]">Zobacz wszystkie</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {articles.length > 0 ? (
                articles.map((article) => {
                    const content = article.content;
                    const imageUrl = content.image?.filename || "https://images.unsplash.com/photo-1577896851231-70ef18881754?w=800&q=80";
                    return (
                        <a href={`/artykuly/${article.slug}`} class="bg-white rounded-3xl p-6 shadow-sm hover:-translate-y-1 transition-transform border border-slate-100 flex flex-col h-full">
                            <div class="aspect-video rounded-2xl overflow-hidden mb-6 relative bg-slate-100">
                                <img src={imageUrl} alt={content.title} class="w-full h-full object-cover" />
                                {content.category && (
                                    <div class="absolute top-3 left-3 bg-white px-3 py-1 rounded-full text-xs font-bold text-[#0f172a] uppercase">
                                        {content.category}
                                    </div>
                                )}
                            </div>
                            <h4 class="text-xl font-bold text-[#0f172a] mb-3">{content.title}</h4>
                            <p class="text-slate-500 text-sm mb-6 flex-grow">{content.excerpt}</p>
                            <div class="mt-auto pt-4 border-t border-slate-50 text-[#0f172a] font-bold text-sm">Czytaj artykuł →</div>
                        </a>
                    );
                })
            ) : (
                <div class="col-span-3 text-center p-12 border-2 border-dashed border-slate-300 rounded-3xl text-slate-500">Brak dodanych artykułów w systemie.</div>
            )}
        </div>
    </div>
</section>