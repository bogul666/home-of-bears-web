---
import { useStoryblokApi } from '@storyblok/astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PricingCalculator from '../components/PricingCalculator.jsx';
import ZapisyModal from '../components/ZapisyModal.astro'; 
import LekcjaModal from '../components/LekcjaModal.astro'; 
import '../styles/global.css';

const storyblokApi = useStoryblokApi();
let globalSettings = {};
try {
  const { data } = await storyblokApi.get('cdn/stories/ustawienia/global', {
    version: import.meta.env.DEV ? "draft" : "published",
  });
  globalSettings = data.story;
} catch (error) {
  console.log("Używam domyślnego navbara, nie znaleziono ustawień globalnych");
}
---

<html lang="pl" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kursy Grizzly Youngsters (10-12 lat) - Home of Bears</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="font-sans text-slate-800 bg-[#FCFAF5] antialiased overflow-x-hidden">

    <Navbar blok={globalSettings?.content} />

    <!-- HERO SECTION -->
    <header class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-white border-b border-slate-100">
        <!-- Zmienione kolory blobów na nieco "starsze" (fioletowo-niebieskie akcenty) -->
        <div class="absolute top-0 right-0 w-[40rem] h-[40rem] bg-indigo-50 rounded-full mix-blend-multiply filter blur-[80px] -translate-y-1/2 translate-x-1/3"></div>
        <div class="absolute bottom-0 left-0 w-[30rem] h-[30rem] bg-[#fef5f3] rounded-full mix-blend-multiply filter blur-[80px] translate-y-1/3 -translate-x-1/4"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                
                <div>
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-600 font-bold text-sm mb-6 shadow-sm uppercase tracking-wider">
                        🐻 Kursy Grizzly Youngsters | Grupa Wiekowa: 10-12 lat
                    </div>
                    <h1 class="text-5xl md:text-6xl font-extrabold text-[#0f172a] tracking-tight leading-[1.1] mb-6">
                        Angielski, który staje się <span class="text-[#F38160]">ich supermocą.</span>
                    </h1>
                    <p class="text-lg md:text-xl text-slate-600 mb-8 leading-relaxed font-medium">
                        Czas buntu to zły moment na szkolną presję. Kursy Youngsters to nauka oparta na relacjach rówieśniczych, angażujących projektach i NVC. Rozgadamy Twoje dziecko bez stresowania go sprawdzianami.
                    </p>
                    
                    <div class="flex flex-col sm:flex-row gap-4">
                        <button onclick="toggleModal('eduskyModal')" class="px-8 py-4 bg-[#F38160] text-white font-bold rounded-xl hover:bg-[#e56742] transition-all shadow-md text-center cursor-pointer">
                            Zapisz na zajęcia
                        </button>
                        <a href="#cennik" class="px-8 py-4 bg-white border-2 border-slate-200 text-slate-700 font-bold rounded-xl hover:border-[#F38160] hover:text-[#F38160] transition-all text-center">
                            Sprawdź cennik
                        </a>
                    </div>
                </div>

                <div class="relative">
                    <div class="aspect-square md:aspect-[4/3] rounded-[2.5rem] overflow-hidden shadow-2xl relative z-10 border-8 border-white">
                        <img src="https://a.storyblok.com/f/295239851056156/1200x900/1ee0239a84/angielski-native-speaker-gliwice.jpg" alt="Młodzież pracująca w grupie" class="w-full h-full object-cover">
                    </div>
                    <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-2xl shadow-xl z-20 border border-slate-100 flex items-center gap-4">
                        <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center text-xl font-bold"><i class="fa-solid fa-people-group"></i></div>
                        <div>
                            <p class="font-bold text-[#0f172a] text-sm">Social Technology</p>
                            <p class="text-xs text-slate-500">Moc grupy i relacji</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </header>

    <section id="metoda" class="py-24 bg-[#FCFAF5]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-[#F38160] font-bold uppercase tracking-wider text-sm mb-3">Twarde Fakty</h2>
                <h3 class="text-4xl font-extrabold text-[#0f172a] leading-tight mb-6">Jak uczymy pre-nastolatków?</h3>
                <p class="text-lg text-slate-600 font-medium">To wiek, w którym rówieśnicy stają się najważniejsi, a motywacja zależy od pasji. Wykorzystujemy to do nauki żywego języka.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:-translate-y-1 transition-transform">
                    <div class="w-14 h-14 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center text-2xl mb-6"><i class="fa-regular fa-clock"></i></div>
                    <h4 class="font-bold text-[#0f172a] text-lg mb-3">1x 90 lub 2x 60 min</h4>
                    <p class="text-slate-600 text-sm leading-relaxed">Solidna dawka zanurzenia w języku (Deep Work). Mamy czas na gramatykę, swobodne rozmowy, żarty i projekt grupowy.</p>
                </div>
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:-translate-y-1 transition-transform">
                    <div class="w-14 h-14 bg-[#fdeae5] text-[#F38160] rounded-2xl flex items-center justify-center text-2xl mb-6"><i class="fa-solid fa-gamepad"></i></div>
                    <h4 class="font-bold text-[#0f172a] text-lg mb-3">Język w akcji</h4>
                    <p class="text-slate-600 text-sm leading-relaxed">Uczniowie dyskutują, odgrywają role i realizują zadania bliskie ich zainteresowaniom (gry, muzyka, internet).</p>
                </div>
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:-translate-y-1 transition-transform">
                    <div class="w-14 h-14 bg-indigo-50 text-indigo-500 rounded-2xl flex items-center justify-center text-2xl mb-6"><i class="fa-solid fa-shapes"></i></div>
                    <h4 class="font-bold text-[#0f172a] text-lg mb-3">Gramatyka w Złotym Podziale</h4>
                    <p class="text-slate-600 text-sm leading-relaxed">Nie "wkuwamy" regułek. Używamy Golden Division – pokazujemy struktury gramatyczne jako logiczne schematy i obrazy do zrozumienia.</p>
                </div>
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:-translate-y-1 transition-transform">
                    <div class="w-14 h-14 bg-purple-50 text-purple-500 rounded-2xl flex items-center justify-center text-2xl mb-6"><i class="fa-solid fa-handshake-angle"></i></div>
                    <h4 class="font-bold text-[#0f172a] text-lg mb-3">Partnerstwo (NVC)</h4>
                    <p class="text-slate-600 text-sm leading-relaxed">Lektor jest mentorem, nie "nauczycielem z linijką". Szanujemy granice ucznia, akceptujemy gorsze dni i wspieramy w blokadach.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ZAAKCENTOWANA SEKCJA EDUKACYJNA -->
    <section class="py-24 bg-white border-t border-slate-100 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                
                <div class="order-2 lg:order-1 relative">
                    <div class="absolute -inset-4 bg-[#FCFAF5] rounded-[3rem] -z-10 transform -rotate-1"></div>
                    
                    <h2 class="text-[#F38160] font-bold uppercase tracking-wider text-sm mb-3">Wiek Pre-Teens</h2>
                    <h3 class="text-3xl md:text-4xl font-extrabold text-[#0f172a] leading-tight mb-6">Przechodzimy od zabawy do świadomej komunikacji</h3>
                    <p class="text-slate-600 font-medium leading-relaxed mb-8 text-lg">
                        10-12 lat to moment, gdy dzieci nie chcą być traktowane jak maluchy. Oczekują wyzwań i poważnego traktowania. Dlatego w grupie Youngsters <strong>uczymy poprzez współpracę i rozwiązywanie problemów</strong>.
                    </p>

                    <div class="space-y-8">
                        <div class="flex gap-5">
                            <div class="w-14 h-14 rounded-2xl bg-white border border-[#fbc5b6] text-[#F38160] shadow-sm flex items-center justify-center flex-shrink-0 mt-1">
                                <i class="fa-solid fa-comments text-2xl"></i>
                            </div>
                            <div>
                                <h4 class="text-xl font-bold text-[#0f172a] mb-2">Praktyczne użycie języka</h4>
                                <p class="text-slate-600 leading-relaxed font-medium">Stawiamy na konwersacje. Uczeń musi potrafić wyrazić swoją opinię, obronić swoje zdanie czy po prostu porozmawiać o wczorajszym meczu w 100% po angielsku.</p>
                            </div>
                        </div>
                        <div class="flex gap-5">
                            <div class="w-14 h-14 rounded-2xl bg-white border border-indigo-200 text-indigo-500 shadow-sm flex items-center justify-center flex-shrink-0 mt-1">
                                <i class="fa-solid fa-users-rays text-2xl"></i>
                            </div>
                            <div>
                                <h4 class="text-xl font-bold text-[#0f172a] mb-2">Social Technology w praktyce</h4>
                                <p class="text-slate-600 leading-relaxed font-medium">Grupa rówieśnicza to silny motor napędowy. Zamiast testów, uczniowie pracują w parach i mikrogrupach, rozwiązując zadania zmuszające do interakcji i negocjacji.</p>
                            </div>
                        </div>
                        <div class="flex gap-5">
                            <div class="w-14 h-14 rounded-2xl bg-white border border-green-200 text-green-500 shadow-sm flex items-center justify-center flex-shrink-0 mt-1">
                                <i class="fa-solid fa-bullseye text-2xl"></i>
                            </div>
                            <div>
                                <h4 class="text-xl font-bold text-[#0f172a] mb-2">Odpowiedzialność za naukę</h4>
                                <p class="text-slate-600 leading-relaxed font-medium">Przekazujemy odpowiedzialność w ręce ucznia. Uczymy planowania nauki (self-regulation), co przydaje się nie tylko na angielskim, ale w całej późniejszej edukacji.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="order-1 lg:order-2">
                    <div class="aspect-square md:aspect-[4/5] rounded-[3rem] overflow-hidden shadow-xl relative border-8 border-white">
                        <img src="https://a.storyblok.com/f/295239851056156/1200x1600/4b9d12eadc/angielski-dla-mlodziezy-gliwice.jpg" alt="Uczeń piszący i myślący na zajęciach" class="w-full h-full object-cover">
                        <!-- Nakładka z misiem -->
                        <div class="absolute bottom-6 right-6 w-24 h-24 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center shadow-lg border border-slate-100 p-2 transform rotate-12 hover:rotate-0 transition-transform">
                            <img src="/grizzly_youngster.png" alt="Grizzly Youngster Mascot" class="w-full h-full object-contain drop-shadow-md" onerror="this.style.display='none'; this.parentNode.innerHTML='<i class=\'fa-solid fa-star text-3xl text-yellow-400\'></i>'">
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <section class="py-24 bg-[#0f172a] relative overflow-hidden">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-[#F38160] rounded-full mix-blend-multiply filter blur-3xl opacity-30"></div>
        <div class="absolute bottom-0 left-0 w-96 h-96 bg-indigo-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <h2 class="text-[#F38160] font-bold uppercase tracking-wider text-sm mb-3">Współpraca z Domem</h2>
            <h3 class="text-3xl md:text-5xl font-extrabold text-white leading-tight mb-8">Zaufanie i Transparentność</h3>
            <p class="text-lg text-slate-300 max-w-2xl mx-auto font-medium mb-16">
                Twoje dziecko zyskuje niezależność, ale Ty wciąż trzymasz rękę na pulsie dzięki nowoczesnemu systemowi raportowania i bezpośredniemu kontaktowi z lektorem.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
                <div class="bg-white/10 backdrop-blur-sm border border-white/20 p-8 rounded-[2rem] hover:-translate-y-1 transition-transform">
                    <div class="w-14 h-14 bg-[#F38160] text-white rounded-2xl flex items-center justify-center text-2xl mb-6 shadow-sm"><i class="fa-solid fa-comment-dots"></i></div>
                    <h4 class="text-white font-bold text-xl mb-3">Opisowy Feedback</h4>
                    <p class="text-slate-300 text-sm leading-relaxed font-medium">Brak ocen tradycyjnych (1-6) nie oznacza braku pomiaru wiedzy. Stosujemy cykliczny feedback opisowy. Informujemy Cię, nad jakimi kompetencjami dziecko obecnie pracuje.</p>
                </div>
                
                <div class="bg-white/10 backdrop-blur-sm border border-white/20 p-8 rounded-[2rem] hover:-translate-y-1 transition-transform relative overflow-hidden flex flex-col">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500 rounded-full mix-blend-overlay filter blur-3xl opacity-50"></div>
                    <div class="w-14 h-14 bg-blue-500 text-white rounded-2xl flex items-center justify-center text-2xl mb-6 shadow-sm relative z-10"><i class="fa-solid fa-mobile-screen"></i></div>
                    <h4 class="text-white font-bold text-xl mb-3 relative z-10">Strefa Rodzica eduSky</h4>
                    <p class="text-slate-300 text-sm leading-relaxed font-medium relative z-10 flex-grow">
                        Nasze centrum dowodzenia. W e-dzienniku sprawdzisz frekwencję, finanse oraz wiadomości od lektora, bez konieczności pobierania dodatkowych aplikacji.
                    </p>
                    <a href="https://homeofteddy.edusky.pl/" target="_blank" rel="noopener noreferrer" class="mt-6 text-white font-bold border-b border-blue-400 pb-1 hover:text-blue-300 self-start transition-colors relative z-10">
                        Zaloguj się do e-dziennika &rarr;
                    </a>
                </div>
                
                <div class="bg-white/10 backdrop-blur-sm border border-white/20 p-8 rounded-[2rem] hover:-translate-y-1 transition-transform">
                    <div class="w-14 h-14 bg-indigo-500 text-white rounded-2xl flex items-center justify-center text-2xl mb-6 shadow-sm"><i class="fa-solid fa-scale-balanced"></i></div>
                    <h4 class="text-white font-bold text-xl mb-3">Wsparcie w buncie</h4>
                    <p class="text-slate-300 text-sm leading-relaxed font-medium">Gdy pojawia się spadek motywacji (częsty w tym wieku), nie stosujemy kar, lecz mediacje SNO. Diagnozujemy potrzebę leżącą pod niechęcią i wspólnie znajdujemy rozwiązanie.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SEKCJA FAQ -->
    <section class="py-24 bg-[#F8FAFC] border-t border-slate-100">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-[#F38160] font-bold uppercase tracking-wider text-sm mb-3">Częste obawy</h2>
                <h3 class="text-3xl md:text-4xl font-extrabold text-[#0f172a] leading-tight">Odpowiadamy szczerze i wprost</h3>
            </div>

            <div class="space-y-6">
                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                    <h4 class="text-lg font-bold text-[#0f172a] mb-3 flex items-start gap-3">
                        <span class="text-[#F38160]">Q:</span> Czy uczycie gramatyki, skoro nie robicie nudnych testów?
                    </h4>
                    <p class="text-slate-600 leading-relaxed text-sm font-medium">Oczywiście! Gramatyka jest rusztowaniem języka. Uczymy jej jednak w innowacyjny sposób (Golden Division). Zamiast wkuwać tabelki, młodzież poznaje wizualne schematy i od razu używa ich w ustnej komunikacji.</p>
                </div>

                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                    <h4 class="text-lg font-bold text-[#0f172a] mb-3 flex items-start gap-3">
                        <span class="text-[#F38160]">Q:</span> Moje dziecko ma już zaległości w szkole. Czy da sobie u Was radę?
                    </h4>
                    <p class="text-slate-600 leading-relaxed text-sm font-medium">Jak najbardziej. Nasze zajęcia nie polegają na rywalizacji o oceny, więc uczeń nie czuje się gorszy. Bezpieczna atmosfera buduje pewność siebie, co często skutkuje szybkim i naturalnym nadrobieniem zaległości ze szkoły.</p>
                </div>

                <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                    <h4 class="text-lg font-bold text-[#0f172a] mb-3 flex items-start gap-3">
                        <span class="text-[#F38160]">Q:</span> Co jeśli moje dziecko w tym wieku w ogóle nie chce się uczyć angielskiego?
                    </h4>
                    <p class="text-slate-600 leading-relaxed text-sm font-medium">To klasyczny spadek motywacji wieku pre-teen. Rozmawiamy z uczniami jako mentorzy. Odbudowujemy ich zaangażowanie pokazując, do czego użyteczny jest angielski w ich prywatnych pasjach (gry, youtube, podróże).</p>
                </div>
            </div>
        </div>
    </section>

    <!-- KALKULATOR CEN -->
    <PricingCalculator client:load title="Inwestycja w program Grizzly Youngsters" />

    <Footer />
    
    <LekcjaModal />
    <ZapisyModal />

    <!-- Skrypt do Modali -->
    <script is:inline>
        window.toggleModal = function(modalID) {
            const modal = document.getElementById(modalID);
            if(!modal) return;
            
            const backdrop = modal.querySelector('.modal-backdrop');
            const panel = modal.querySelector('.modal-panel');
            
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                void modal.offsetWidth; 
                backdrop?.classList.add('opacity-100');
                backdrop?.classList.remove('opacity-0');
                panel?.classList.add('opacity-100', 'translate-y-0', 'sm:scale-100');
                panel?.classList.remove('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                document.body.style.overflow = 'hidden';
            } else {
                backdrop?.classList.remove('opacity-100');
                backdrop?.classList.add('opacity-0');
                panel?.classList.remove('opacity-100', 'translate-y-0', 'sm:scale-100');
                panel?.classList.add('opacity-0', 'translate-y-4', 'sm:translate-y-0', 'sm:scale-95');
                
                setTimeout(() => {
                    modal.classList.add('hidden');
                    document.body.style.overflow = 'auto';
                }, 300);
            }
        }
    </script>
</body>
</html>