---
const currentYear = new Date().getFullYear();
---

<!-- Używamy w-screen i tricku z marginesem/transformacją, by wymusić 100% szerokości i przełamać kontener na szerokość -->
<footer class="bg-[#0f172a] w-screen relative left-1/2 -translate-x-1/2 py-20 border-t-4 border-[#F38160] overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        
        <!-- Sekcja CTA na środku -->
        <h2 class="text-4xl md:text-5xl font-extrabold tracking-tighter mb-8 text-white">
            Masz pytania? Jesteśmy <span class="text-[#F38160]">dla Ciebie.</span>
        </h2>
        <p class="text-lg text-slate-300 mb-12 max-w-2xl mx-auto font-medium leading-relaxed">
            Nic nie ryzykujesz. Zadzwoń do nas, aby porozmawiać o potrzebach Twojego dziecka, lub od razu umów się na darmową, niezobowiązującą lekcję pokazową.
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center gap-4 mb-20 flex-wrap">
            <!-- NOWY PRZYCISK: Zapis na kurs (eduSky) -->
            <button onclick="toggleModal('eduskyModal')" class="px-8 py-5 bg-[#F38160] text-white font-bold rounded-2xl hover:bg-[#e56742] transition-all shadow-[0_15px_30px_-10px_rgba(243,129,96,0.4)] hover:-translate-y-1 text-lg cursor-pointer">
                Zapisz dziecko na kurs
            </button>
            
            <!-- POPRAWIONY PRZYCISK: Darmowa lekcja (Lekki kontrast - biały na ciemnym tle) -->
            <button onclick="toggleModal('lekcjaModal')" class="px-8 py-5 bg-white text-[#0f172a] font-bold rounded-2xl hover:bg-slate-100 transition-all hover:-translate-y-1 text-lg cursor-pointer">
                Darmowa lekcja
            </button>

            <!-- Zadzwoń (Glassmorphism) -->
            <a href="tel:+48572772998" class="px-8 py-5 bg-white/5 border border-white/10 backdrop-blur-sm text-white font-bold rounded-2xl hover:bg-white/10 transition-all hover:-translate-y-1 text-lg flex items-center justify-center">
                <i class="fa-solid fa-phone mr-3 text-[#F38160]"></i> 572 772 998
            </a>
        </div>
        
        <!-- Grid z informacjami -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 text-left border-t border-slate-700 pt-16">
            
            <!-- Kolumna 1: O nas -->
            <div>
                <img src="/logo_p.png" alt="Home of Bears" class="h-16 mb-6 brightness-0 invert opacity-90 object-contain">
                <p class="text-slate-300 text-sm leading-relaxed font-medium">
                    Nowoczesna szkoła językowa. Przełamujemy bariery językowe przez empatię (NVC) i ruch. Uczymy w zaufaniu, bez podręczników, ocen i niepotrzebnego stresu.
                </p>
            </div>

            <!-- Kolumna 2: Na skróty -->
            <div>
                <h5 class="font-bold text-white mb-6 text-lg">Na skróty</h5>
                <ul class="space-y-4 text-slate-300 text-sm font-medium">
                    <li>
                        <a href="https://homeofbearsonline.pl" class="hover:text-white hover:pl-1 transition-all inline-block">
                            Angielski Online
                        </a>
                    </li>
                <!--   <li>
                        <a href="/szkolenia" class="hover:text-white hover:pl-1 transition-all inline-block">
                            Szkolenia i Konferencje
                        </a>
                    </li> -->
                    <li>
                        <a href="/praca" class="hover:text-white hover:pl-1 transition-all inline-block">
                            Praca (Kariera)
                        </a>
                    </li>
                    <li>
                        <a href="/baza_wiedzy" class="hover:text-white hover:pl-1 transition-all inline-block">
                            Baza Wiedzy
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Kolumna 3: Lokalizacje -->
            <div>
                <h5 class="font-bold text-white mb-6 text-lg">Nasze lokalizacje</h5>
                <ul class="space-y-5 text-slate-300 text-sm font-medium">
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-location-dot mt-1 text-[#F38160]"></i>
                        <span><strong class="text-white block mb-1">Gliwice</strong>ul. Przyszowska 67</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-location-dot mt-1 text-[#F38160]"></i>
                        <span><strong class="text-white block mb-1">Gliwice</strong>ul. Elsnera 23</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fa-solid fa-location-dot mt-1 text-[#F38160]"></i>
                        <span><strong class="text-white block mb-1">Żory</strong>ul. Bankowa 4a/2b</span>
                    </li>
                </ul>
            </div>

            <!-- Kolumna 4: Kontakt i Social Media -->
            <div>
                <h5 class="font-bold text-white mb-6 text-lg">Kontakt</h5>
                <ul class="space-y-4 text-slate-300 text-sm font-medium">
                    <li>
                        <a href="tel:+48572772998" class="hover:text-white transition-colors flex items-center gap-3">
                            <i class="fa-solid fa-phone text-[#F38160]"></i> +48 572 772 998
                        </a>
                    </li>
                    <li>
                        <a href="mailto:biuro@homeofbears.pl" class="hover:text-white transition-colors flex items-center gap-3">
                            <i class="fa-solid fa-envelope text-[#F38160]"></i> biuro@homeofbears.pl
                        </a>
                    </li>
                </ul>
                
                <!-- Ikonki Social Media -->
                <div class="mt-8 flex gap-4 text-xl">
                    <a href="https://www.facebook.com/szkolateddy" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center hover:bg-[#1877F2] hover:border-[#1877F2] hover:text-white transition-all text-slate-300 hover:-translate-y-1 shadow-sm">
                         <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"></path>
                        </svg>
                    </a>
                    <a href="https://www.instagram.com/homeofbears_pl/" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center hover:bg-[#E4405F] hover:border-[#E4405F] hover:text-white transition-all text-slate-300 hover:-translate-y-1 shadow-sm">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"></path>
                        </svg>
                    </a>
                    <a href="https://www.youtube.com/@homeofbears_pl" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center hover:bg-[#FF0000] hover:border-[#FF0000] hover:text-white transition-all text-slate-300 hover:-translate-y-1 shadow-sm">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.769-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd"></path>
                        </svg>
                    </a>
                </div>
            </div>

        </div>

        <!-- Pasek Copyright -->
        <div class="mt-16 pt-8 border-t border-slate-700 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-400 text-sm font-medium">
            <p>&copy; {currentYear} Home of Bears. Wszystkie prawa zastrzeżone.</p>
            <div class="flex gap-6">
                <a href="/polityka-prywatnosci" class="hover:text-white transition-colors">Polityka Prywatności</a>
                <a href="/regulamin" class="hover:text-white transition-colors">Regulamin</a>
            </div>
            <p>Strategia & Design: <span class="text-white font-bold">Michał Bogulski według TAYA</span></p>
        </div>
        
    </div>
</footer>